# ==================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# 
# Copy this file to .env and configure values before starting the pipeline:
# cp example.env .env
# ==================================================================



# ------------------------------------------------------------------
# 1. PIPELINE ENVIRONMENT - OPT: DEV, PROD, TEST
# ------------------------------------------------------------------
ENVIRONMENT=DEV

# ------------------------------------------------------------------
# 2. DISCORD WEBHOOK - for alerting and monitoring
# ------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ------------------------------------------------------------------
# 3. TWITCH API CREDENTIALS - get at https://dev.twitch.tv/console/apps
# ------------------------------------------------------------------
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# ------------------------------------------------------------------
# 4. STORAGE / AZURITE 
# ------------------------------------------------------------------
# DEV: Azurite local emulator (Default connection string)
dev_STORAGE_ACCOUNT_URL=http://127.0.0.1:10000/devstoreaccount1
dev_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;

# PROD: Real Azure Data Lake Storage Gen2 (DFS endpoint with DefaultAzureCredential)
prod_STORAGE_ACCOUNT_URL=https://<your_storage_account>.dfs.core.windows.net

# ------------------------------------------------------------------
# 5. POSTGRES (for Logs and the Analytics Layer)
# ------------------------------------------------------------------
# DEV: (Matches docker-compose.yml configuration)
DEV_POSTGRES_USER=postgres
DEV_POSTGRES_PASSWORD=postgres
DEV_POSTGRES_HOST=localhost
DEV_POSTGRES_PORT=5432
DEV_POSTGRES_DB=igdb_elt

# PROD: (Azure Database for PostgreSQL Flexible Server)
PROD_POSTGRES_USER=pgadmin
PROD_POSTGRES_PASSWORD=your_secure_prod_password
PROD_POSTGRES_HOST=your-server.postgres.database.azure.com
PROD_POSTGRES_PORT=5432
PROD_POSTGRES_DB=igdb_elt

# ------------------------------------------------------------------
# 6. GOVERNANCE & ANALYTICS WEB APP
# ------------------------------------------------------------------
FLASK_SECRET_KEY=aero_governance_secret_key_2026_igdb
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
VIEWER_USERNAME=visitor
VIEWER_PASSWORD=visitor123
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

